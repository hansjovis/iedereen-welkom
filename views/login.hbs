<form class="card container" {{#if active_credentials}} method="POST" {{/if}}>
    <header>
        <img src="/icons/login.svg" class="icon" alt=""/>
        <h1>Log in to {{client.name}}</h1>
    </header>
    <div class="card-body">
        <div class="input-row">
            <label for="email_Address">Email address</label>
            <input type="email" name="email_address" id="emailAddress" value="{{email_address}}" required>
        </div>
        <!-- Hidden fields -->
        <input type="hidden" name="client_id" value="{{client.id}}">
        <input type="hidden" name="response_type" value="{{client.response_type}}">
        <input type="hidden" name="redirect_uri" value="{{client.redirect_uri}}">
        <!-- /Hidden fields -->
        {{#each active_credentials}}
        {{> (concat "login/" this) }}
        {{/each}}
    </div>
    <footer>
        <button type="submit">
            <img src="/icons/login.svg" class="icon" alt=""/>
            Log in
        </button>
    </footer>
</form>