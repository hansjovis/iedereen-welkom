<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Auth - Login</title>
    <style>
        body {
            height: 90vh;
            font-family: Arial, Helvetica, sans-serif;
        }
        h1, h2, h3, h4, h5, h6, p {
            margin: 0;
            padding: 0;
        }
        p {
            margin-block-start: 0.5rem;
        }
        footer {
            margin-block-start: 0.5rem;
        }
        .center-content {
            display: grid;
            place-content: center;
        }
        .card {
            padding: 8px 16px;
            margin: 8px;
            border: 1px solid gray;
            border-radius: 4px;
        }
        label, input {
            display: block;
        }
        .input-row {
            margin-block-start: 0.5rem;
        }
        #error {
            position: absolute;
            background-color: darkred;
            color: white;
        }
        #notification {
            position: absolute;
            background-color: green;
            color: white;
        }
        form {
            width: 300px;
            max-width: 300px;
        }
        input {
            padding: 4px 8px;
        }
    </style>
</head>
<body class="center-content">
    {{#if error }}
    <div id="error" class="card">
        <p><b>Error</b>: {{ error }}</p>
    </div>
    {{/if}}
    {{#if success }}
    <div id="notification" class="card">
        <p><b>Success</b>: {{ success }}</p>
    </div>
    {{/if}}
    <form class="card" {{#if activeCredentials}} method="POST" {{/if}}>
        <header>
            <h1>Log in</h1>
        </header>
        <div class="input-row">
            <label for="emailAddress">Email address</label>
            <input type="email" name="emailAddress" id="emailAddress" value="{{emailAddress}}">
        </div>
        {{#each activeCredentials}}
        <div class="input-row">
            <label for="{{this.id}}">{{this.label}}</label>
            <p>{{this.description}}</p>
            <input type="{{this.type}}" {{#if this.pattern}}pattern="{{this.pattern}}"{{/if}} name="{{this.id}}" id="{{this.id}}" value="{{this.value}}">
        </div>
        {{/each}}
        <footer>
            <button type="submit">Log in</button>
        </footer>
    </form>
</body>
</html>