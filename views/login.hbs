<form class="card container" {{#if activeCredentials}} method="POST" {{/if}}>
    <header>
        <img src="/icons/login.svg" class="icon" alt=""/>
        <h1>Log in</h1>
    </header>
    <div class="card-body">
        <div class="input-row">
            <label for="emailAddress">Email address</label>
            <input type="email" name="emailAddress" id="emailAddress" value="{{emailAddress}}" required>
        </div>
        {{#each activeCredentials}}
        {{> (concat "login/" this) }}
        {{/each}}
    </div>
    <footer>
        <button type="submit">
            <img src="/icons/login.svg" class="icon" alt=""/>
            Log in
        </button>
    </footer>
</form>