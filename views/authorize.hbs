<form class="card container" method="post">
    <header>
        <h1>Authorize {{client.name}}</h1>
    </header>
    <section class="card-body">
        <p>
            <b>{{client.name}}</b> wants to have access to some of your information.
            You can find a list below.
        </p>
        <p>
            Please select for each piece of information whether you want <b>{{client.name}}</b>
            to have access to it.
        </p>
        <p>
            Note that you can always revoke, or permit, access again via your <a href="/users/{{user.userName}}">user page</a>.
        </p>
    </section>
    <input type="hidden" name="client_id" value="{{client.id}}">
    <input type="hidden" name="redirect_uri" value="{{redirect_uri}}">
    {{#each requestedPermissions}}
    <fieldset>
        <legend>{{scope.name}}</legend>
        <p>{{reason}}</p>
        <div class="toggle-radio" data-color="green">
            <input 
                type="radio"
                name="permissions.{{scope.id}}" 
                id="permissions.{{scope.id}}.allow" 
                value="Allowed"
            >
            <label for="permissions.{{scope.id}}.allow">Allow</label>
            <input 
                type="radio"
                name="permissions.{{scope.id}}" 
                id="permissions.{{scope.id}}.deny" 
                value="Denied"
            >
            <label for="permissions.{{scope.id}}.deny">Deny</label>
        </div>
    </fieldset>
    {{/each}}
    <footer>
        <button type="submit">Save permissions</button>
    </footer>
</form>